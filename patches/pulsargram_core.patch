// [FILE 3: Telegram/SourceFiles/data/data_session.cpp - Anti-Delete]
// ---------------------------------------------------------------------
// Предотвращает локальное удаление сообщений из кэша и помечает их как [Удалено]
--- a/Telegram/SourceFiles/data/data_session.cpp
+++ b/Telegram/SourceFiles/data/data_session.cpp
@@ -1420,7 +1420,13 @@ void SessionData::deleteMessages(
 	const std::vector<MsgId> &ids,
 	bool fromServer) {
 	for (const auto msgId : ids) {
 		if (const auto item = message(msgId)) {
+			// MirnGram Anti-Delete: не удаляем сообщение, а выставляем флаг
+			if (fromServer && !item->out()) {
+				item->markMirnDeleted(); // Помечает сообщение красным тегом [Удалено]
+				continue;
+			}
 			item->destroy();
 		}
 	}
 }

